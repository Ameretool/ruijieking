---
// 博客文章阅读详情页
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrostedGlass from '../../components/FrostedGlass.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, category, tags } = post.data;
---

<BaseLayout title={`${title} — ruijieking`}>
  <div class="max-w-2xl mx-auto px-6 pt-24 pb-16">
    <FrostedGlass>
      <!-- 分类标签 -->
      <span class="inline-block text-xs font-medium tracking-wide uppercase
                   text-accent bg-accent/10 px-2.5 py-1 rounded-full mb-3">
        {category}
      </span>

    <!-- 标题 -->
    <h1 class="text-4xl font-bold text-fg leading-tight">
      {title}
    </h1>

    <!-- 描述 -->
    <p class="mt-3 text-fg/50 text-lg leading-relaxed">
      {description}
    </p>

    <!-- 日期 + 标签 -->
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 pb-8 border-b border-fg/10">
      <time datetime={pubDate} class="text-sm text-fg/35 font-mono">
        {pubDate}
      </time>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-sm text-fg/40">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <!-- 正文：prose 排版 -->
    <div class="mt-8 prose prose-neutral dark:prose-invert max-w-none text-lg
                prose-p:leading-relaxed prose-p:my-5 prose-p:text-fg/80
                prose-headings:text-fg prose-headings:font-semibold prose-headings:mt-10 prose-headings:mb-5
                prose-h2:text-2xl prose-h3:text-xl
                prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                prose-code:text-accent prose-code:bg-fg/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-base prose-code:font-normal
                prose-pre:bg-fg/5 prose-pre:border prose-pre:border-fg/10 prose-pre:my-8 prose-pre:rounded-xl
                prose-img:rounded-xl prose-img:my-8
                prose-li:my-2 prose-li:leading-relaxed
                prose-blockquote:border-l-accent prose-blockquote:bg-fg/3 prose-blockquote:rounded-r-lg
                prose-hr:border-fg/10 prose-hr:my-10
                prose-strong:text-fg prose-strong:font-semibold
                prose-table:border-fg/10">
      <Content />
    </div>
    </FrostedGlass>
  </div>
</BaseLayout>
