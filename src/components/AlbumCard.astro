---
// 相册卡片组件：检测 public/album/ 下的相册文件夹，三层叠加封面
// 排序：按相册内最新一张照片的修改时间，倒序（最新在前）
import fs from 'node:fs';
import path from 'node:path';
import AnimateIn from './AnimateIn.astro';

const albumRoot = path.join(process.cwd(), 'public', 'album');
const imageExt = /\.(jpg|jpeg|png|webp|gif|avif)$/i;



// 如果 public/album 目录不存在，直接返回空数组，保证构建成功
let albums: { name: string; images: string[]; mtime: number }[] = [];
if (fs.existsSync(albumRoot)) {
  albums = fs.readdirSync(albumRoot, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => {
      const dir = path.join(albumRoot, d.name);
      const images = fs.readdirSync(dir)
        .filter((f) => imageExt.test(f))
        .sort();
      // 相册时间：取最新一张照片的修改时间
      let mtime = 0;
      for (const img of images) {
        const t = fs.statSync(path.join(dir, img)).mtimeMs;
        if (t > mtime) mtime = t;
      }
      return { name: d.name, images, mtime };
    })
    .filter((a) => a.images.length > 0)
    .sort((a, b) => b.mtime - a.mtime);
}
---

<div class="grid grid-cols-3 gap-4">
  {albums.length === 0 ? (
    <p class="text-fg/50 col-span-3">还没有相册。</p>
  ) : (
    albums.map((album, i) => (
      <AnimateIn delay={i * 80}>
        <a
          href={`/photo/${encodeURIComponent(album.name)}`}
          class="block group transition-all duration-300 hover:-translate-y-0.5"
        >
          <!-- 透明容器：无磨砂背景，仅保留文字 -->
          <div class="p-3">
            <!-- 三层叠加封面：第1张最上(0°)，第2张中层(20°)，第3张最下(-210°) -->
            <div class="relative aspect-square">
              {album.images[2] && (
                <img
                  src={encodeURI(`/album/${album.name}/${album.images[2]}`)}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-md
                         -rotate-[210deg] translate-x-[-10px] translate-y-[12px] scale-[0.86]
                         opacity-90 z-10"
                />
              )}
              {album.images[1] && (
                <img
                  src={encodeURI(`/album/${album.name}/${album.images[1]}`)}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-md
                         rotate-[20deg] translate-x-[8px] translate-y-[-8px] scale-[0.93]
                         opacity-95 z-20"
                />
              )}
              {album.images[0] && (
                <img
                  src={encodeURI(`/album/${album.name}/${album.images[0]}`)}
                  alt={album.name}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-lg z-30
                         transition-transform duration-300 group-hover:scale-[1.03]"
                />
              )}
            </div>

            <!-- 相册信息：相册名居中显示在照片框下方 -->
            <div class="mt-3 text-center px-1">
              <h2 class="text-base font-bold text-fg group-hover:text-accent transition-colors duration-200 truncate">
                {album.name}
              </h2>
              <span class="text-xs text-fg/40 font-mono block mt-0.5">{album.images.length} 张</span>
            </div>
          </div>
        </a>
      </AnimateIn>
    ))
  )}
</div>
