---
// 通用入场动画包装组件
// 用法：<AnimateIn delay={100}> <你的内容 /> </AnimateIn>
// delay 单位毫秒，用于列表错开动画，默认 0
export interface Props {
  delay?: number;
}

const { delay = 0 } = Astro.props;
---

<div
  class="animate-in"
  style={`animation-delay: ${delay}ms;`}
>
  <slot />
</div>

<style>
  .animate-in {
    /* 内容始终可见（不隐藏成透明），只做轻微上移动画，避免切页时背景闪现 */
    transform: translateY(8px);
    animation: fadeUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fadeUp {
    to {
      transform: translateY(0);
    }
  }
</style>
