---
//默认布局，所有页面都必须套上这个布局，不然壁纸和导航栏功能不能正常工作
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import WallpaperPicker from '../components/WallpaperPicker.astro';

const { title = 'ruijieking的博客' } = Astro.props;
const currentPath = Astro.url.pathname;

function navClass(href: string) {
  const isActive = currentPath === href;
  return isActive
    ? 'text-accent bg-accent/10 font-medium'
    : 'text-fg/60 hover:text-accent hover:bg-fg/5';
}
---
 

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
   
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>

  <script is:inline>
  // 更改网页图标的配置代码在这里，默认使用favicon.png名字和格式图片， <link rel="icon" type="image/png" href="/favicon.png" />
 
 
  // ===== 第一层：首屏防闪（FOUC）=====
  // 必须在 head 里同步执行，在浏览器画第一帧之前设好主题
  (function () {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();

  // ===== 第二层：ClientRouter 切页防闪 =====
  // ClientRouter 导航后不重跑 inline 脚本，
  // 必须监听 astro:after-swap 事件，在新页面渲染前重新设主题
  function applyTheme() {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  }
  document.addEventListener('astro:after-swap', applyTheme);
  </script>
  </head>

  <body class="bg-bg text-fg min-h-screen flex flex-col">
    <!-- 岛屿式导航栏：悬浮胶囊 + 毛玻璃 -->
    <header class="sticky top-4 z-50 flex justify-center">
      <div class="flex items-center gap-150 px-20 py-4 rounded-full
                  bg-bg/15 backdrop-blur-2xl
                  shadow-lg shadow-black/5
                  text-lg">
        <a href="/" class="font-bold text-accent hover:opacity-80 transition-opacity">ruijieking</a>
        <nav class="flex items-center gap-1">
          <a href="/talk" class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass('/talk')]}>今日说法</a>
          <a href="/blog" class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass('/blog')]}>文章</a>
          <a href="/archive" class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass('/archive')]}>归档</a>
          <a href="/photo" class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass('/photo')]}>照片</a>
          <a href="/about" class:list={['px-3 py-1.5 rounded-full transition-all duration-200', navClass('/about')]}>关于我</a>
          <ThemeToggle />
          <WallpaperPicker />
        </nav>
      </div>
    </header>

    <!-- slot 是"页面内容插入的洞"：layout 提供外壳，页面的内容填进这里 -->
    <main class="flex-1">
      <slot />
    </main>

    <footer class="px-8 py-6 border-t border-fg/10 text-sm opacity-60">
      ruijieking
    </footer>
  </body>
</html>